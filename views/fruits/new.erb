<h2>Ny frukt</h2>

<form class="add" action="/fruits" method="post">
    <label>Frukt: <input type="text" name="fruit_name"></label>
    <label>Smakpoäng: <input type="text" name="fruit_tastiness"></label>
    <label>Beskrivning: <input type="text" name="fruit_description"></label>
    <label>Kategori: 
        <select name="fruit_category">
	        <% @categories.each do |category| %>
		        <option value="<%= category['id'] %>"><%= category['name'] %></option>
            <% end %>
        </select>
    </label>
    <input type="submit" value="Spara">
</form>