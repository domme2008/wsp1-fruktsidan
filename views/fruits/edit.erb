<h2>Uppdatera frukt</h2>

<form class="edit" action="/fruits/<%= @fruit['id'] %>/update" method="post">
    <label>Frukt: <input type="text" name="fruit_name" value="<%= @fruits['fruit_name']%>"></label>
    <label>Smakpoäng: <input type="text" name="fruit_tastiness" value="<%= @fruits['fruit_tastiness']%>"></label>
    <label>Beskrivning: <input type="text" name="fruit_description" value="<%= @fruits['fruit_description']%>"></label>
    <input type="submit" value="Ändra">
</form>