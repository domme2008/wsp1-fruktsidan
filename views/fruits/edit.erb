<h2>Uppdatera frukt</h2>

<form action="/fruits/<%= @fruit['id'] %>/update" method="post">
    <label>Frukt: <input type="text" name="fruit_name" value="<%= @fruit['fruit_name']%>"></label>
    <label>Smakpoäng: <input type="text" name="fruit_tastiness" value="<%= @fruit['fruit_tastiness']%>"></label>
    <label>Beskrivning: <input type="text" name="fruit_description" value="<%= @fruit['fruit_description']%>"></label>
    <label>Kategori: 
        <select name="fruit_category">
	        <% @categories.each do |category| %>
		        <option value="<%= category['id'] %>"><%= category['name'] %></option>
            <% end %>
        </select>
    </label>
    <input type="submit" value="Ändra">
</form>